{
	"name": "@giltiq/sdk",
	"version": "0.1.1",
	"description": "Node.js SDK for the Giltiq VAT Validation API",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc",
		"test": "echo 'SDK tests require running API'"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"giltiq",
		"vat",
		"vat-validation",
		"vies",
		"bzst",
		"tax",
		"eu",
		"b2b",
		"api"
	],
	"author": "Giltiq <hello@giltiq.de> (https://giltiq.de)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/giltiq/giltiq-node.git"
	},
	"homepage": "https://giltiq.de/docs",
	"bugs": {
		"url": "https://github.com/giltiq/giltiq-node/issues"
	},
	"devDependencies": {
		"typescript": "^5.6.0"
	}
}
